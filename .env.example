TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
PORT=5000

# Firebase Configuration (for FCM Push Notifications)
# Option 1: Place service-account-key.json in project root (recommended)
# Option 2: Set these environment variables:
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_PRIVATE_KEY="your_private_key_with_escaped_newlines"
# FIREBASE_CLIENT_EMAIL=your_client_email@your_project.iam.gserviceaccount.com
